
&star_job
      show_log_description_at_start = .false.

      load_saved_model = .true.
      load_model_filename = 'mods/start.mod'

      save_model_when_terminate = .true.
      save_model_filename = 'mods/removed_core.mod'

      remove_initial_center_by_radius_cm = 7.1d8

      pgstar_flag = .false.


/ ! end of star_job namelist

&kap
  use_Type2_opacities = .true.
  Zbase = 0.02d0

/ ! end of kap namelist

&controls
  ! initial conditions (ignored for a loaded model)
  initial_mass = 0.8
  initial_z = 0.02

  ! stopping condition
  max_model_number = 5 ! 1000

  ! ouput
  terminal_interval = 1
  write_header_frequency = 10
  photo_interval = 10
  history_interval = 1
  profile_interval = 10

  ! Things to panic about if they become important
  gamma_center_limit = 1000

  min_timestep_limit = 1d-12

  ! Convection parameters
  mixing_length_alpha = 1.9
  ! use_Ledoux_criterion = .true.
  ! alpha_semiconvection = 0.001
  ! thermohaline_coeff = 2
  MLT_option = 'Henyey'

/ ! end of controls namelist

&pgstar
  read_extra_pgstar_inlist(1) = .true.
  extra_pgstar_inlist_name(1) = 'inlist_pgstar'

/ ! end of pgstar namelist
