  ! might need this if you go to higher resolution (mesh_delta_coeff < 1.0)
  ! max_allowed_nz = 20000
  mesh_delta_coeff = 1.0

  ! make remesher care more about changes in h1 and he4 abundances
  xa_function_species(1) = 'h1'
  xa_function_species(2) = 'he4'
  xa_function_weight(1) = 20
  xa_function_weight(2) = 20

  xa_function_param(1) = 1d-06
  xa_function_param(2) = 0.01

  ! make timesteps bigger and cut down on retries at the expense of
  ! sloppier convergence
  tol_max_correction = 0.03

  ! shrink this to get finer time resolution during "happy" times
  varcontrol_target = 1e-3

  ! set limits on how much different quantities can change between timesteps
  delta_lgRho_limit = 1
  delta_lgRho_hard_limit = -1

  delta_lgT_limit = 0.5

  delta_lgL_H_limit = 0.1
  delta_lgL_H_hard_limit = 0.5
  lgL_H_burn_min = 1

  delta_lgL_He_limit = 0.25

  lgL_He_burn_min = 2.5

  delta_lgTeff_limit = 0.1

  delta_lgL_limit = 0.05

/ ! end of controls namelist

&pgstar
  read_extra_pgstar_inlist(1) = .true.
  extra_pgstar_inlist_name(1) = 'inlist_pgstar'

  Abundance_xaxis_name = 'logxm'
  Abundance_xaxis_reversed = .true.
  Abundance_xmin = -8
  Abundance_xmax = -3

  Summary_Burn_xaxis_name = 'logxm'
  Summary_Burn_xaxis_reversed = .true.
  Summary_Burn_xmin = -8
  Summary_Burn_xmax = -3

  Grid8_win_flag = .true.
  Grid8_win_width = 7

  Grid8_file_flag = .false.
  Grid8_file_dir = 'png'
  Grid8_file_prefix = '1.00Msun_Tc_3e7_mdot_1.00e-09_Z0.00_grid8_'
  Grid8_file_interval = 1
  Grid8_file_width = -1
  Grid8_file_aspect_ratio = -1

/ ! end of pgstar namelist
