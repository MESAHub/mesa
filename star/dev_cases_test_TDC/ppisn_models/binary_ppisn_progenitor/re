#!/usr/bin/env bash

shopt -u expand_aliases

photo_directory=photos

function most_recent_photo {
    bp=$(ls -tp "$photo_directory/"b_* | head -1)
    echo ${bp#"$photo_directory/"b_}
}

if [ $# -eq 0 ]
then
    photo=$(most_recent_photo)
else
    photo=$1
fi

# Star 2 is evolved throughout; star 1 becomes a point mass after helium depletion.
if [ -z "$photo" ] || ! [ -f "$photo_directory/b_$photo" ] || ! [ -f "$photo_directory/2_$photo" ]
then
    echo "Not all specified photos exist: $photo"
    exit 1
fi

echo "restart from $photo"
echo "$photo" > .restart

MESA_INLIST=inlist_binary make run
