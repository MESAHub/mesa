&kap
cubic_interpolation_in_X = .false.
cubic_interpolation_in_Z = .false.

kap_file_prefix = 'gs98'    ! 'gs98' 'a09'  'OP_a09' 'OP_gs98'
kap_CO_prefix   = 'gs98_co' ! 'gs98_co' 'a09_co'
kap_lowT_prefix = 'lowT_fa05_gs98'
use_Type2_opacities = .false. ! keep same fixed-Z opacity setup as labs 1 and 2
Zbase = 0.006d0 ! LMC metallicity used by the Friday Cepheid models

/

&eos
/

&star_job

   save_model_when_terminate = .true.
   save_model_filename = 'final.mod'
   !required_termination_code_string = 'Successful test: evolve through 5 pulsation cycles.'

   load_saved_model = .true.
   load_model_filename = 'mod_dir/YOUR_MODEL.mod'

   change_v_flag = .true.
   new_v_flag = .true.

   set_initial_dt = .true.
   years_for_initial_dt = -1
   seconds_for_initial_dt = 1d7

   set_initial_cumulative_energy_error = .true.
   new_cumulative_energy_error = 0d0

   set_initial_age = .true.
   initial_age = 0

   set_initial_model_number = .true.
   initial_model_number = 0

   pgstar_flag = .true.

! on first pass, uncomment below if you are loading from an evolution model.
   remove_initial_center_by_temperature = 2d6
   remove_center_set_zero_v_center = .true. ! set center v = 0

   initial_zfracs = 3

/ !end of star_job namelist


&controls
   ! let the rse know we are in inlist_pulses, useful for multi_inlist setups.
   x_logical_ctrl(22) = .true. ! flag for in inlist_pulses

   ! limit max model number as part of testing.
   !max_model_number = 3000

   ! controls for analyzing pulsations using GYRE in MESA
   x_logical_ctrl(37) = .true. ! turn on GYRE


   x_integer_ctrl(1) = 1000 ! gyre interval to check
   x_integer_ctrl(2) = 3 ! max number of modes to output per call

   x_logical_ctrl(7) = .true. ! doing pulses
   x_integer_ctrl(7) = -1 ! 3 ! which period to check (<= 0 means don't check any)
   x_ctrl(7) = -1d0 ! expected period in days; <= 0 uses the dynamical time until a period is measured
   x_ctrl(8) = -1 ! min_deltaR_for_periods (Rsun)
   x_ctrl(9) = 1d0 ! KE_growth_avg_abs_frac_new ! for averaging growth rates across steps.
   x_ctrl(10) = 0.1 ! min_period_div_target

! other gyre in mesa controls
    !write_pulse_data_with_profile = .true.
    pulse_data_format = 'GYRE'
    x_logical_ctrl(1) = .false. ! save GYRE info whenever save profile
    x_logical_ctrl(2) = .false. ! output eigenfunction files
    x_integer_ctrl(3) = 0 ! mode l (e.g. 0 for p modes, 1 for g modes)

   ! should match gyre.in mode l
    x_integer_ctrl(4) = 1 ! order
    x_ctrl(1) = 0.158d-05 ! freq ~ this (Hz)
    x_ctrl(2) = 0.33d+03 ! growth < this (days)

! Meshing
   ! option 1
   remesh_for_TDC_pulsations_when_load = .true.
   TDC_hydro_use_mass_interp_face_values = .false.
   TDC_hydro_nz = 220
   TDC_hydro_nz_outer = 80
   TDC_hydro_nz_inner = 20
   TDC_hydro_nz_T_gradient = 20
   TDC_hydro_T_anchor = 11d3
   TDC_hydro_dq_1_factor = 2d0
   remesh_for_TDC_pulsations_log_core_zoning = .false. ! .false means do rsp style core

   ! option 2, set okay_to_remesh = .true.
   ! and only partially remesh from evol model for a few timesteps.
   okay_to_remesh = .false. ! freeze mesh after initial remesh.
   x_logical_ctrl(24) = .false. ! only used if okay_to_remesh = .true.
   x_ctrl(12) = 200 ! model number to turn off remesh ( only if if okay_to_remesh = .true.)

   ! if you use option 2 not TDC_hydro remesh, uncomment the items below.
   !P_function_weight = 0
   !min_surface_cell_dq = 1d-8
   !max_surface_cell_dq = 1d0
   !max_num_merge_surface_cells = 5

! GYRE set starting velocities, kick!
! kick when true and not restarting.
! if not using hydro, kick automatically turns v_flag on.
   x_logical_ctrl(5) = .true. ! to turn on gyre kick
   x_ctrl(11) = 200! kick model at this model number

   x_ctrl(4) = 0d0 ! fraction_1st_overtone (order 2)
   x_ctrl(5) = 0d0 ! fraction_2nd_overtone (order 3)
   x_ctrl(6) = 10d0 ! initial vsurf (kms)

! Convection model
   steps_before_use_TDC = 0
   MLT_option = 'TDC'
   include_mlt_corr_to_TDC = .false. ! true K. 1986 model, no mlt limiting
   TDC_include_eturb_in_energy_equation = .true.
   mixing_length_alpha = 1.77d0
   TDC_alpha_M = 0.25d0
   use_ledoux_criterion = .true.
   TDC_num_innermost_cells_forced_nonturbulent = 2 ! for envelope models only.

! hydro solver
   use_TDC_Y_face_seeded_newton = .true.
   use_face_reconstruction = .true.
   hydro_matrix_solver = 'banded'

! timesteps for saturation

  ! TDC Pulsation timestepping.
   ! x_ctrl(17/18) are base max timestep caps before/during pulsation.
   ! After x_ctrl(13), run_star_extras also limits dt using the
   ! dynamical time or measured pulsation period.
   x_ctrl(13) = 100 ! model number to drop timestep
   x_ctrl(17) = 1d5 ! dt before pulse, seconds
   x_ctrl(18) = 1d5 ! After a pulse begins, limit the timestep to this (in seconds).

   ! have used these values to do run to saturation, but may not be necessary ~ Bill P.
   dt_div_min_dr_div_cs_limit = 10d0! set less than 1d0 in high L/M stars.
   dt_div_min_dr_div_cs_hard_limit = 100d0! i don't like hard limits ~ EbF
   min_abs_u_div_cs_for_dt_div_min_dr_div_cs_limit = 0.8d0
   min_q_for_dt_div_min_dr_div_cs_limit = 0d0
   max_q_for_dt_div_min_dr_div_cs_limit = 1d0
   min_k_for_dt_div_min_dr_div_cs_limit = 1
   min_abs_du_div_cs_for_dt_div_min_dr_div_cs_limit = 0.001d0

! OUTER BC for TDC Pulsations
   use_momentum_outer_BC = .true. ! adopt this if not using rsp and zero P bc.

! velocity time centering for v_flag only.
   steps_before_use_velocity_time_centering = 300 ! no v centering when commented
   use_P_d_1_div_rho_form_of_work_when_time_centering_velocity = .true.

   include_P_in_velocity_time_centering = .true. ! set to false for u_flag
   P_theta_for_velocity_time_centering = 0.5d0

   include_L_in_velocity_time_centering = .true.
   L_theta_for_velocity_time_centering = 0.5d0

   include_mlt_in_velocity_time_centering = .false.

   set_rho_to_dm_div_dV = .false.

! controls for shock capturing, relaxed for pulsations
   ! main purpose is to force radiative in shock face
    max_abs_du_div_cs_for_convection = 10d0
    max_v_div_cs_for_convection = 1d2
    max_v_for_convection = 1d4

! artificial viscosity if necessary, v_flag only
   use_Pvsc_art_visc = .true.
   Pvsc_cq = 4.0d0
   Pvsc_zsh = 0.1d0

! turn off burning and mixing, if evolving envelope model
   eps_nuc_factor = 0
   non_nuc_neu_factor = 0
   dxdt_nuc_factor = 0
   mix_factor = 0

! output
   log_directory = 'LOGS_pulsation'

    photo_digits = 8
    photo_interval = 1000
    profile_interval = 10000
    history_interval = 100
    terminal_interval = 100
    max_num_profile_models = 1000000 ! 100 ! RECOMMENDED 10000

! terminal output
    num_trace_history_values = 2
    trace_history_value_name(1) = 'log_rel_run_E_err'
    trace_history_value_name(2) = 'rel_E_err'
    warn_when_large_rel_run_E_err = 1d99

    terminal_show_age_units = 'days'
    terminal_show_timestep_units = 'secs'
    terminal_show_log_dt = .false.
    terminal_show_log_age = .false.

! solver, relax solver hard for summer school
    use_gold2_tolerances = .false.
    gold_iter_for_resid_tol2 = 3 ! default is 5
    gold_tol_residual_norm3 = 1d-4
    gold_tol_max_residual3= 1d-2
    make_gradr_sticky_in_solver_iters = .true.

! Debugging
   report_solver_progress = .false.
   report_ierr = .false. ! if true, produce terminal output when have some internal error

/ ! end of controls namelist

&pgstar

Grid1_file_dir = 'png_pulsation'

pgstar_interval = 100


/ ! end of pgstar namelist
