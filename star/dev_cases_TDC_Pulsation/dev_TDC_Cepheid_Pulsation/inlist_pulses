   save_model_when_terminate = .true.
   save_model_filename = 'final.mod'

   ! Select one hydrodynamic velocity variable.
   change_v_flag = .true.
   new_v_flag = .true.
   change_u_flag = .true.
   new_u_flag = .false.

   set_initial_dt = .true.
   years_for_initial_dt = -1
   seconds_for_initial_dt = 1d9

   set_initial_cumulative_energy_error = .true.
   new_cumulative_energy_error = 0d0
   set_initial_age = .true.
   initial_age = 0d0
   set_initial_model_number = .true.
   initial_model_number = 0

   ! Remove the core when loading a full evolutionary model.
   !remove_initial_center_by_temperature = 2d6
   remove_initial_center_by_temperature = 7d6 ! model_00000800.mod
   remove_center_set_zero_v_center = .true.

change_rsp2_flag = .true.
new_rsp2_flag = .false.

   !initial_zfracs = 6
   pgstar_flag = .true.

relax_to_this_tau_factor = 1d-3
dlogtau_factor = 0.1d0
relax_tau_factor = .false.
relax_initial_tau_factor = .true.

/

&controls
   ! This flag enables the pulse-only logic in run_star_extras.
   x_logical_ctrl(22) = .true.
   max_model_number = -1
   tol_max_correction = 1d99
   rsp2_remesh_when_load=.false.
   rsp2_alfam= 4.5d0
   !min_dq_for_xa = 1d-4
   RSP2_use_L_eqn_at_surface = .false.
   !rsp2_alfat = 0.1d0
   !RSP2_num_outermost_cells_forced_nonturbulent = 1

   ! Star LNA
   star_LNA_flag = .true.
   star_LNA_model_number = 200
   star_LNA_stop_after_run = .false.
   star_LNA_T_inner = 0d0 ! inner envelope temperature in K; <= 0 uses the complete model
   star_LNA_num_modes = 15
   star_LNA_solver = 'dense'

   ! Heuristics used to build the selected mode list. The dense solve still
   ! computes all roots, which remain available in star_LNA_raw_modes.data.
   star_LNA_min_mode_frequency_uHz = 2.314814814814815d-3 ! 5000-day maximum period
   star_LNA_min_first_mode_eta = -3d0 ! minimum logKE per cycle for the first mode
   star_LNA_min_mode_eta = -5d0 ! minimum logKE per cycle for later modes
   star_LNA_max_abs_mode_eta = 100d0 ! 0 disables the absolute logKE guard
   star_LNA_max_eigenvector_residual = 1d0 !1d-8

   star_LNA_output_file_prefix = 'star_LNA'
   star_LNA_output_directory = 'LNA'
   star_LNA_write_matrix_summary = .true.
   star_LNA_write_period_growth = .true.
   star_LNA_write_eigenfunctions = .true.
   star_LNA_write_work_integrals = .true.

   star_LNA_set_initial_velocity = .true.
   star_LNA_mode_for_period = 0 ! zero-based terminal-table mode used for the reported period
   star_LNA_kick_vsurf_km_per_sec = 5d0
   star_LNA_kick_mode_1 = 1 ! one-based index in the selected mode list
   star_LNA_kick_fraction_1 = 1d0
   star_LNA_kick_mode_2 = 0
   star_LNA_kick_fraction_2 = 0d0
   star_LNA_kick_mode_3 = 0
   star_LNA_kick_fraction_3 = 0d0

   star_LNA_include_tdc = .true.
   star_LNA_include_rsp2 = .false.
   star_LNA_perturb_convective_flux = .true.
   star_LNA_perturb_turbulent_pressure = .true.
   star_LNA_perturb_eddy_viscosity = .true.
   star_LNA_perturb_turbulent_energy = .true.
   star_LNA_convection_treatment = 'perturbed'

   ! Pulsation diagnostics
   x_logical_ctrl(7) = .true. ! measure nonlinear pulsation cycles
   x_integer_ctrl(7) = -1 ! number of cycles before stopping; <= 0 disables
   x_ctrl(7) = -1d0 ! expected period in days; <= 0 uses dynamical time until a period is measured
   x_ctrl(8) = -1d0 ! minimum radius excursion in Rsun; <= 0 disables
   x_ctrl(9) = 1d0 ! new-cycle weight in the running growth average
   x_ctrl(10) = 0.1d0 ! minimum period as a fraction of the target period

   ! TDC Pulsation timestepping.
   x_ctrl(13) = 190 ! model number to drop timestep
   x_ctrl(17) = 1d9 ! 1d5 ! dt before pulse, seconds
   x_ctrl(18) = 1d6 ! fallback timestep ceiling after pulsations begin, seconds
   x_integer_ctrl(8) = 600 ! requested timesteps per pulsation period

   dt_div_min_dr_div_cs_limit = 4d0
   dt_div_min_dr_div_cs_hard_limit = -1d0 !100d0
   min_abs_u_div_cs_for_dt_div_min_dr_div_cs_limit = 0.8d0
   min_q_for_dt_div_min_dr_div_cs_limit = 0d0
   max_q_for_dt_div_min_dr_div_cs_limit = 1d0
   min_k_for_dt_div_min_dr_div_cs_limit = 1
   min_abs_du_div_cs_for_dt_div_min_dr_div_cs_limit = 0.001d0

   ! One-time TDC envelope remesh; -1 disables, 0 is before the first step,
   ! and a positive value waits for that many accepted steps.
   steps_before_remesh_for_TDC_pulsations = -1 !100
   TDC_hydro_use_mass_interp_face_values = .true.
   TDC_hydro_nz = 1200 !350 !190 ! 150-zone base grid + 20 inner + 20 T-gradient
   TDC_hydro_nz_outer = 400 !120 !40
   TDC_hydro_nz_inner = 100 !50 !20
   TDC_hydro_nz_T_gradient = 300 ! 50
   TDC_hydro_T_anchor = 11d3
   TDC_hydro_dq_1_factor = 2d0
   max_center_cell_dq = 1d-7
   remesh_for_TDC_pulsations_log_core_zoning = .false.
   mesh_adjust_get_T_from_E = .false. ! can interact poorly with adjust_mass.
   !max_rel_delta_IE_for_mesh_total_energy_balance = 0d0 ! when above is false.

   okay_to_remesh = .true. ! enable standard mesh adjustment
   x_logical_ctrl(24) = .false. ! turn off standard remeshing at x_ctrl(12)
   x_ctrl(12) = 100 ! model number to turn off standard remeshing

   mesh_delta_coeff = 1d0
   max_num_merge_surface_cells = 20
   max_surface_cell_dq= 1d0
   min_surface_cell_dq = 1d-8
   log_tau_function_weight = 30
   T_function1_weight = 80
   P_function_weight = 0 ! must be set 0 if doing remesh, when using Pvsc, or risk resolving single zone art visc P.

   ! Optionally restore the old mesh on retry and hold it for later steps.
   restore_mesh_on_retry = .false.
   num_steps_to_hold_mesh_after_retry = 0

   ! Time-dependent convection
   MLT_option = 'TDC'
   steps_before_use_TDC = 0
   use_ledoux_criterion = .false.
   include_mlt_corr_to_TDC = .false.
   TDC_use_dynamical_gradL = .true. ! Ledoux pressure-inversion fallback is not fully supported.
   TDC_include_eturb_in_energy_equation = .true.

   num_cells_for_smooth_gradL_composition_term = 0
   mixing_length_alpha = 3d0
   harmonic_dissipation_length_beta = 1d0 ! radial limiting length is beta*r
   TDC_alpha_C = 1d0
   TDC_alpha_S = 1d0
   TDC_alpha_D = 1d0
   TDC_alpha_R = 0d0
   TDC_alpha_Pt = 0d0
   TDC_alpha_M = 0.5d0
   TDC_alpha_M_use_explicit_mlt_vc_in_momentum_equation = .true.

   use_rsp_form_of_scale_height = .false.
   alt_scale_height_flag = .false.
   use_TDC_enthalpy_flux_limiter = .false.
   mlt_Pturb_factor = 0d0
   include_mlt_Pturb_in_thermodynamic_gradients = .false.
   TDC_num_innermost_cells_forced_nonturbulent = 2

   ! Temperature-gradient equation
   use_dPrad_dm_form_of_T_gradient_eqn = .false.
   min_kap_for_dPrad_dm_eqn = 1d-4 ! opacity floor for the dPrad/dm equation
   use_flux_limiting_with_dPrad_dm_form = .false.
   x_logical_ctrl(25) = .true. ! ignore equL residuals for the first 10 models
   !convergence_ignore_equL_residuals = .true. ! include T-gradient equation in Newton solve
   make_gradr_sticky_in_solver_iters = .true.

   ! Hydrodynamics
   use_TDC_Y_face_seeded_newton = .true.
   use_face_reconstruction = .true. ! incompatible with use_rsp_form_of_scale_height
   hydro_matrix_solver = 'banded' ! 'banded'
   no_dedt_form_during_relax = .false.
   set_rho_to_dm_div_dV = .false.

   ! Velocity time centering applies only to v_flag hydrodynamics.
