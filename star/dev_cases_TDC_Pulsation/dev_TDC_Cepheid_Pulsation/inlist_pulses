   non_nuc_neu_factor = 0d0
   dxdt_nuc_factor = 0d0
   mix_factor = 0d0


   ! solver
   use_gold2_tolerances = .true.
   !gold_tol_max_residual3 = 1d-3
   !gold_tol_residual_norm3 = 1d-5
   !gold_tol_residual_norm3 = 1d-4
   !gold_tol_max_residual3 = 1d-2

    gold_solver_iters_timestep_limit = 30
    solver_iters_timestep_limit = 50

   ! Output
   log_directory = 'LOGS'
   photo_digits = 8
   photo_interval = 1000
   profile_interval = 1000 !10000
   history_interval = 1
