   ! Artificial viscosity applies only to v_flag hydrodynamics.
   use_Pvsc_art_visc = .true.
   Pvsc_cq = 100d0 ! bigger for RSGs
   Pvsc_zsh = 0.1d0

   ! Surface boundary conditions
   use_RSP_L_eqn_outer_BC = .false.
   use_zero_Pgas_outer_BC = .false.
   use_compression_outer_BC = .false.
   use_momentum_outer_BC = .true.
