! inlist_pgstar_debug
!
! Solver/convergence debugging window:
!   left, top:     Kipp_residuals  (log10 max_i |equ(i,k)| vs model number and mass)
!   left, bottom:  Max_eq_resid    (log10 max_k |equ(i,k)| per hydro equation)
!   right:         Text_Summary9   (step, energy-error and dynamics diagnostics)
!
! Use from another inlist:
!   &pgstar
!      read_extra_pgstar_inlist(1) = .true.
!      extra_pgstar_inlist_name(1) = 'inlist_pgstar_debug'
!   /
! and set pgstar_flag = .true. in &star_job.
!
! Uses Grid9 and Text_Summary9 to avoid clashing with the usual Grid1/Text_Summary1.

&pgstar

pgstar_interval = 1   ! residuals are only recorded when pgstar is called

! --- residual plots ---
Kipp_residuals_yaxis_name = 'mass'   ! 'mass', 'logR', or 'tau'
Kipp_residuals_title = 'log\d10\u max\di\u |residual|'
Max_eq_resid_title = 'log\d10\u max\dk\u |residual| per equation'
! limit memory/redraw cost on long runs (<= 0: keep everything)
Kipp_residuals_max_width = 500
Max_eq_resid_max_width = 500

! --- text summary: all names are history columns (star/private/star_history_def.f90) ---
Text_Summary9_num_rows = 18
Text_Summary9_num_cols = 1
Text_Summary9_txt_scale = 0.95
Text_Summary9_title = ''
Text_Summary9_name(:,:) = ''

! step
Text_Summary9_name(1,1) = 'model_number'
Text_Summary9_name(2,1) = 'log_star_age'
Text_Summary9_name(3,1) = 'log_dt'                 ! yr
Text_Summary9_name(4,1) = 'num_zones'
Text_Summary9_name(5,1) = 'num_iters'              ! solver iterations, this step
Text_Summary9_name(6,1) = 'num_retries'            ! retries, this step
Text_Summary9_name(7,1) = 'total_step_retries'
Text_Summary9_name(8,1) = 'total_step_redos'

! energy conservation
Text_Summary9_name(9,1) = 'rel_E_err'              ! this step
Text_Summary9_name(10,1) = 'log_rel_run_E_err'     ! cumulative
Text_Summary9_name(11,1) = 'virial_thm_rel_err'

! dynamics / timescales
Text_Summary9_name(12,1) = 'max_abs_v_div_cs'
Text_Summary9_name(13,1) = 'log_dt_div_min_dr_div_cs'  ! Courant-like ratio
Text_Summary9_name(14,1) = 'log_abs_mdot'

! structure
Text_Summary9_name(15,1) = 'star_mass'
Text_Summary9_name(16,1) = 'log_L'
Text_Summary9_name(17,1) = 'log_max_T'
Text_Summary9_name(18,1) = 'log_cntr_Rho'

! --- grid layout ---
Grid9_win_flag = .true.
Grid9_win_width = 13
Grid9_win_aspect_ratio = 0.5

Grid9_xleft = 0.0
Grid9_xright = 1.0
Grid9_ybot = 0.0
Grid9_ytop = 1.0
Grid9_title = ''

Grid9_num_cols = 4
Grid9_num_rows = 5
Grid9_num_plots = 3

Grid9_plot_name(:) = ''
Grid9_plot_row(:) = 1
Grid9_plot_rowspan(:) = 1
Grid9_plot_col(:) = 1
Grid9_plot_colspan(:) = 1
Grid9_plot_pad_left(:) = 0.0
Grid9_plot_pad_right(:) = 0.0
Grid9_plot_pad_top(:) = 0.0
Grid9_plot_pad_bot(:) = 0.0
Grid9_txt_scale_factor(:) = 0.7

! top left: Kippenhahn of residuals (room on the right for the colorbar)
Grid9_plot_name(1) = 'Kipp_residuals'
Grid9_plot_row(1) = 1
Grid9_plot_col(1) = 1
Grid9_plot_colspan(1) = 3
Grid9_plot_rowspan(1) = 3
Grid9_plot_pad_left(1) = 0.06
Grid9_plot_pad_right(1) = 0.06
Grid9_plot_pad_top(1) = 0.05
Grid9_plot_pad_bot(1) = 0.06

! bottom left: max residual per equation (room on the right for the legend)
Grid9_plot_name(2) = 'Max_eq_resid'
Grid9_plot_row(2) = 4
Grid9_plot_col(2) = 1
Grid9_plot_colspan(2) = 3
Grid9_plot_rowspan(2) = 2
Grid9_plot_pad_left(2) = 0.06
Grid9_plot_pad_right(2) = 0.06
Grid9_plot_pad_top(2) = 0.05
Grid9_plot_pad_bot(2) = 0.06

! right: text
Grid9_plot_name(3) = 'Text_Summary9'
Grid9_plot_row(3) = 1
! Grid9_plot_rowspan(3) = 2
Grid9_plot_col(3) = 4
Grid9_plot_pad_left(3) = 0.0
Grid9_plot_pad_right(3) = 0.0
Grid9_plot_pad_top(3) = 0.03
Grid9_plot_pad_bot(3) = 0.03
Grid9_txt_scale_factor(3) = 1.0

! file output (off by default)
Grid9_file_flag = .false.
Grid9_file_dir = 'png'
Grid9_file_prefix = 'debug_'
Grid9_file_interval = 10
Grid9_file_width = -1
Grid9_file_aspect_ratio = -1

/ ! end of pgstar namelist
