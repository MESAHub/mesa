&star_job

! begin with saved model after the dredge-up pulse sequence
      load_saved_model = .true.
      load_model_filename = '2M_3DUP.mod'

! save a model and profile at the end of the run
      save_model_when_terminate = .true.
      save_model_filename = 'he_shell_ignition.mod'
      required_termination_code_string = 'He-shell ignition after interpulse'

      write_profile_when_terminate = .true.
      filename_for_profile_when_terminate = 'final_profile.data'

! restart counters
      set_initial_age = .true.
      initial_age = 0
      set_initial_model_number = .true.
      initial_model_number = 0
      set_initial_cumulative_energy_error = .true.
      new_cumulative_energy_error = 0d0

! display on-screen plots
      !pgstar_flag = .true.

/ !end of star_job namelist

&eos

/ ! end of eos namelist

&kap

/ ! end of kap namelist

&controls
! He-shell ignition after an interpulse
      log_L_upper_limit = 1d99 ! no surface luminosity cutoff
      x_ctrl(1) = 1d2 ! upper bound on interpulse LHe, in Lsun
      x_ctrl(2) = 1d3 ! lower bound on LHe at the next He-shell ignition, in Lsun

! see inlist_common and inlist_TP_AGB

      ! limit max_model_number as part of test_suite
      max_model_number = 2500

/ ! end of controls namelist
