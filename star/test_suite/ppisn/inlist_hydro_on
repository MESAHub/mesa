   max_mdot_redo_cnt = 0

   restore_mesh_on_retry = .true.
   num_steps_to_hold_mesh_after_retry = 5

   MLT_option = "TDC"
   include_mlt_corr_to_TDC = .false.
   TDC_alpha_M = 1d0
   TDC_alpha_M_use_explicit_mlt_vc_in_momentum_equation = .true.
   TDC_include_eturb_in_energy_equation = .true.

  ! for v flag
    use_Pvsc_art_visc = .true.
    Pvsc_cq = 4.0d0
    Pvsc_zsh = 0.1d0

