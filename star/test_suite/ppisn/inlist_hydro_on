   !use_ODE_var_eqn_pairing = .true.
   use_dPrad_dm_form_of_T_gradient_eqn = .true.
   use_momentum_outer_BC = .true.
   floor_momentum_outer_BC_at_Prad = .true.

   use_split_merge_amr = .true.

   mesh_min_dlnR = 1d-9
   merge_if_dlnR_too_small = .true.

