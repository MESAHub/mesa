! ============
! controls_dev
! ============

! .. warning::
!
!  CONTAINS OPTIONS THAT HAVE NOT YET BEEN THE GIVEN A GREEN LIGHT FOR GENERAL USE.
!  IN PARTICULAR, THESE ARE NOT YET FOR USE IN RESEARCH TO BE PUBLISHED.

      ! TDC options
      ! ~~~~~~~~~~~
      ! ::

      compare_TDC_to_MLT = .false.

      ! use_TDC_Y_face_seeded_newton
      ! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~
      ! If true, use the start-of-step TDC Y_face on the first solver
      ! iteration, and the previous solver iteration's TDC Y_face thereafter,
      ! to try a small local positive-Y bracket before the full bracketing path.
      ! The seed is only used during structural solver iterations.
      !
      ! ::

      use_TDC_Y_face_seeded_newton = .false.

      ! Hydro matrix solver options
      ! ~~~~~~~~~~~~~~~~~~~~~~~~~~~
      ! hydro_matrix_solver selects the mesa-star hydro matrix solve.
      ! Options are 'bcyclic' for the existing block cyclic reduction solver
      ! and 'banded' for an RSP-like DGBTRF/DGBTRS banded solve.
      !
      ! ::

      hydro_matrix_solver = 'bcyclic'

      ! RSP2 parameters
      ! ~~~~~~~~~~~~~~~

      !|   RSP2_alfad =     1.0d0         ! turbulent dissipation; damp ~ RSP2_alfad
      !|   RSP2_alfap =     0.0d0         ! turbulent pressure; Pt ~ alfap
      !|   RSP2_alfat =     0.0d0         ! turbulent flux; Lt ~ RSP2_alfat
      !|   RSP2_alfam =     0.25d0        ! turbulent viscosity; Eq and Uq ~ RSP2_alfam
      !|   RSP2_alfar =     0.0d0         ! radiative dissipation of turbulent energy; Dr ~ RSP2_alfar
      !
      ! RSP2 time weighting is determined by the velocity_time_centering controls.
      !
      !     + for Pt and Lt in turbulent energy equation
      !     + for P and grav in momentum equation
      !     + for P and L in energy equation
      !     + for area when multiplied by P
      !
      ! If RSP2_use_L_eqn_at_surface is true,
      ! Lsurf = RSP2_Lsurf_factor*area(1)*clight*crad*T(1)**4.
      ! If false, use the normal atmosphere temperature boundary condition
      ! unless use_RSP_L_eqn_outer_BC or constant_L selects another boundary.
      ! RSP2_use_mass_interp_face_values selects mass-weighted interpolation
      ! from cell centers to RSP2 faces. Face-to-cell averages remain centered.
      !

      ! ::

    RSP2_alfad = 1.0d0
    RSP2_alfap = 0.0d0
    RSP2_alfat = 0.0d0
    RSP2_alfam = 0.25d0
    RSP2_alfar = 0.0d0

    RSP2_min_Lt_div_L_for_overshooting_mixing_type = 1d-4
    RSP2_min_Lc_div_L_for_convective_mixing_type = 1d-4

    RSP2_Lsurf_factor = 0.5d0

    RSP2_report_adjust_w = .false.
    RSP2_use_L_eqn_at_surface = .true.
    RSP2_assume_HSE = .true.
    RSP2_use_mass_interp_face_values = .true.
    ! Retained for inlist compatibility. The algebraic-gradient formulation
    ! uses Lr = Krad*gradT.
    RSP2_use_Stellingwerf_Lr = .true.

    RSP2_num_outermost_cells_forced_nonturbulent = 0
    RSP2_num_innermost_cells_forced_nonturbulent = 0

   RSP2_w_fix_if_neg = 5d-5
   RSP2_source_seed = 0d0

   ! Use the TDC_hydro_* controls for the common TDC and RSP2 remesher.
   ! This legacy trigger remeshes immediately when RSP2 is enabled and the
   ! requested number of zones differs from the current model. Set it false
   ! to use steps_before_remesh_for_TDC_pulsations instead.
   RSP2_remesh_when_load = .true.

   RSP2_nz_div_IBOTOM = 30d0


      ! period controls

      ! ::

    RSP2_target_steps_per_cycle = 600
    RSP2_min_max_R_for_periods = -1

      ! when to stop

      ! ::

    RSP2_max_num_periods = -1
    RSP2_GREKM_avg_abs_frac_new = 0.1d0
    RSP2_GREKM_avg_abs_limit = -1

      ! output data for work integrals during a particular period

      ! ::

    RSP2_work_period = -1
    RSP2_work_filename = 'work.data'

      ! output data for 3d map.  format same as for gnuplot pm3d

      ! ::

    RSP2_write_map = .false.
    RSP2_map_columns_filename = 'map_columns.list'

      ! items listed in your map columns must also appear in your profile columns

      ! ::

    RSP2_map_filename = 'map.data'
    RSP2_map_first_period = -1
    RSP2_map_last_period = -1
    RSP2_map_zone_interval = 2
    RSP2_map_history_filename = 'map_history.data'


! star LNA controls
! =================

      ! These controls configure the MESA/star radial linear nonadiabatic
      ! analysis in star/private/star_LNA.f90. The implementation assembles a
      ! static radial envelope operator and solves a dense generalized
      ! eigenproblem. The velocity variable is face-centered v for the standard
      ! momentum equation and cell-centered u for u_flag hydrodynamics. Hydro
      ! v_flag may be inactive because the LNA supplies its own face velocity
      ! perturbation. The analysis supports the standard and dPrad/dm
      ! temperature gradient forms.
      ! The analysis rejects rotation, RTI, mass corrections, user other_*
      ! hooks, velocity drag, use_compression_outer_BC, or constant_L.
      ! check_star_LNA_model rejects these paths before matrix assembly.
      !
      ! star_LNA_flag
      ! ~~~~~~~~~~~~~
      ! If true, run the analysis once. The analysis writes diagnostics to
      ! log_directory and can optionally set the starting velocity field.
      !
      ! star_LNA_model_number
      ! ~~~~~~~~~~~~~~~~~~~~~
      ! If < 0, run during startup after the model has been loaded and
      ! extras_startup has returned. If >= 0, run once when model_number equals
      ! this value, after extras_start_step and before that timestep is evolved.
      ! Use 200 to mirror the delayed GYRE/RSP kick point in the Cepheid dev
      ! cases.
      !
      ! star_LNA_stop_after_run
      ! ~~~~~~~~~~~~~~~~~~~~~~~
      ! If true, stop the normal star driver before evolution after a successful
      ! LNA solve. This gives a load model, analyze, and exit workflow when
      ! combined with star_LNA_model_number < 0. Leave this false for
      ! velocity kick runs that should continue into nonlinear evolution.
      ! The binary driver does not provide this stop workflow and reports an
      ! error if it is requested for startup analysis.
      !
      ! star_LNA_T_inner
      ! ~~~~~~~~~~~~~~~~
      ! If positive, restrict the LNA to the contiguous surface envelope with
      ! cell temperatures no greater than ``star_LNA_T_inner`` in K. Perturbations
      ! below the selected inner boundary are zero. A nonpositive value uses
      ! the complete model.
      !
      ! star_LNA_num_modes
      ! ~~~~~~~~~~~~~~~~~~
      ! Number of selected positive frequency modes to write. The dense solve
      ! eliminates algebraic density/luminosity/Hp rows, solves the reduced
      ! dynamic variable eigenproblem, then applies the frequency and RSP LINA
      ! growth selections used to choose the printed modes. This does not
      ! reduce the dense eigensolve size; the solver still computes the full
      ! reduced eigensystem before selecting modes.
      !
      ! star_LNA_min_mode_frequency_uHz
      ! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
      ! Minimum cyclic frequency, in microHz, for modes selected into
      ! period_growth/eigenfunction/work output. Raw finite positive frequency
      ! modes are still written to *_raw_modes.data.
      !
      ! This is mainly to keep slow thermal/quasistatic roots from being
      ! mistaken for the first acoustic modes in frozen flux runs without TDC. A
      ! value of 1d-3 microHz only removes periods longer than about 11574 days,
      ! so solar p modes and ordinary Cepheid radial modes are unaffected. Set
      ! to 0d0 to disable this frequency floor.
      !
      ! star_LNA_min_first_mode_eta, star_LNA_min_mode_eta
      ! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
      ! Existing lower filters for selected modes. The filtered quantity is
      ! logKE_per_cycle = 4*pi*sigma_real/sigma_imag. These filters reject
      ! strongly damped roots while retaining nearly neutral acoustic modes with
      ! logKE_per_cycle near zero.
      !
      ! star_LNA_max_abs_mode_eta
      ! ~~~~~~~~~~~~~~~~~~~~~~~~~
      ! Optional symmetric logKE_per_cycle guard for selected modes. If > 0,
      ! skip roots with abs(logKE_per_cycle) above this value. This catches
      ! pathological thermal roots with enormous growth or decay per period; it
      ! does not affect raw mode output. Set to 0d0 to disable the guard.
      !
      ! star_LNA_max_eigenvector_residual
      ! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
      ! Maximum componentwise backward error accepted for a selected mode. The
      ! residual is evaluated against the original full generalized eigenproblem
      ! after reconstructing and unscaling the eigenvector. Candidate modes with
      ! an initial residual no larger than 1d-1 are refined against the full
      ! block-banded pencil before this limit is applied. This must be > 0.
      !
      ! star_LNA_output_file_prefix
      ! ~~~~~~~~~~~~~~~~~~~~~~~~~~~
      ! File stem for star_LNA output filenames. If empty, use 'star_LNA'. This
      ! is a file prefix, not a path. Leading/trailing / or \ characters are
      ! ignored; internal path separators are converted to underscores so path
      ! handling stays in star_LNA_output_directory.
      ! Use distinct file prefixes for multiple LNA calls; files with the same
      ! directory and prefix are replaced.
      !
      ! star_LNA_output_directory
      ! ~~~~~~~~~~~~~~~~~~~~~~~~~
      ! Directory for files written by star_LNA. If empty, use log_directory.
      ! The chosen directory is created if needed, like normal MESA log output.
      ! The path is <directory>/<prefix>_*.data relative to the run directory;
      ! e.g. if log_directory = 'LOGS_pulsation', star_LNA_output_directory = '',
      ! and file_prefix = 'star_LNA', files are written as
      ! LOGS_pulsation/star_LNA_*.data. Set this to '.' to write in the run
      ! directory, or to a separate directory such as 'LOGS_LNA'.
      ! <prefix>_matrix_summary.data, <prefix>_row_structure.data,
      ! <prefix>_rsp2_term_audit.data or <prefix>_tdc_face_audit.data when
      ! applicable, <prefix>_period_growth.data, <prefix>_raw_modes.data,
      ! <prefix>_eigenfunction_<mode>.data, and <prefix>_work_<mode>.data.
      !
      ! star_LNA_write_matrix_summary
      ! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
      ! If true, write <prefix>_matrix_summary.data with static background
      ! residual diagnostics for the assembled rows.
      !
      ! star_LNA_write_period_growth
      ! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~
      ! If true, write <prefix>_period_growth.data with the selected mode list.
      ! This also writes <prefix>_raw_modes.data with the finite positive
      ! eigenvalues before the RSP growth selection. These are written
      ! after the dense eigensolve succeeds.
      ! The output column is logKE_per_cycle = 4*pi*sigma_real/sigma_imag, the
      ! RSP LINA log kinetic energy convention. For nonlinear comparisons use
      ! ke_fractional_growth_per_period = exp(logKE_per_cycle)-1,
      ! grekm_growth_per_period = 2*tanh(logKE_per_cycle/2), or
      ! amplitude_fractional_growth_per_period = exp(logKE_per_cycle/2)-1.
      !
      ! star_LNA_write_eigenfunctions
      ! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
      ! If true, write <prefix>_eigenfunction_<mode>.data for each selected
      ! mode. Turn this off when only periods/growth rates or a kick are needed.
      !
      ! star_LNA_write_work_integrals
      ! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
      ! If true, write <prefix>_work_<mode>.data for each selected mode. This is
      ! the star_LNA equivalent of RSP LINA_work*.data, but controlled
      ! explicitly instead of always being written. No eigenfunction/work files
      ! are written if no modes pass selection or if the eigensolve has not
      ! completed. Pressure and turbulent pressure terms use the same closure as
      ! the operator. Eddy viscosity and luminosity work columns have not been
      ! compared with matched RSP/RSP2 output. Their sum is not constrained to
      ! reproduce the eigenvalue growth rate.
      !
      ! star_LNA_set_initial_velocity
      ! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
      ! If true, use as many as three selected modes as a velocity kick after the LNA
      ! solve. The kick updates the active v or u hydrodynamic variable and its
      ! current and start-of-step solver state. For u_flag, the corresponding
      ! Riemann face state is also rebuilt. For RSP/RSP2 models, the period
      ! selected by star_LNA_mode_for_period is copied into rsp_period/RSP2_period.
      ! This requires v_flag or u_flag. The LNA solve itself can still run without
      ! a hydrodynamic velocity variable. If ``star_LNA_T_inner`` restricts the
      ! domain, the kick sets the velocity below the selected envelope to zero.
      ! This is incompatible with use_fixed_vsurf_outer_BC because that BC
      ! constrains the LNA surface velocity and makes the requested
      ! surface velocity scaling undefined.
      !
      ! star_LNA_kick_vsurf_km_per_sec
      ! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
      ! Surface velocity amplitude for the optional kick, in km/s. Each selected
      ! eigenfunction is converted to an RSP real velocity profile from
      ! the displacement eigenfunction, normalized to positive unit surface
      ! displacement. The final sum is scaled so the active surface velocity is
      ! 1d5*star_LNA_kick_vsurf_km_per_sec in cgs units. star_LNA prints the
      ! maximum velocity and velocity/csound after applying the kick; a large
      ! interior/surface amplitude ratio identifies a mode whose interior velocity
      ! is much larger than its requested surface amplitude.
      !
      ! star_LNA_mode_for_period
      ! ~~~~~~~~~~~~~~~~~~~~~~~~
      ! Index in the selected mode list, starting at zero. A value of 0 selects the
      ! first mode in <prefix>_period_growth.data, not the reduced LAPACK eigen
      ! index.
      ! This chooses the period copied into rsp_period/RSP2_period.
      !
      ! star_LNA_kick_mode_1, star_LNA_kick_mode_2, star_LNA_kick_mode_3
      ! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
      ! Mode numbers in <prefix>_period_growth.data start at one. For the optional
      ! velocity kick. star_LNA_kick_mode_1 must be >= 1; 0 disables the second
      ! or third component. Set star_LNA_num_modes at least as large as the
      ! largest active kick mode requested.
      !
      ! star_LNA_kick_fraction_1, star_LNA_kick_fraction_2,
      ! star_LNA_kick_fraction_3
      ! ~~~~~~~~~~~~~~~~~~~~~~~~
      ! Relative weights for the kick components. The active weights are
      ! normalized by their sum, so fractions 1,0,0 and 0.7,0.2,0.1 both
      ! produce the requested surface velocity amplitude with different mode
      ! content.
      !
      ! star_LNA_solver
      ! ~~~~~~~~~~~~~~~
      ! Eigensolver selector. The only accepted value is 'dense'. This path uses
      ! LAPACK DGGEV on the reduced generalized eigenproblem. Runtime and memory
      ! increase with the full reduced matrix size because mode selection occurs
      ! after all eigenvalues and right eigenvectors have been computed.
      !
      ! star_LNA_include_tdc
      ! ~~~~~~~~~~~~~~~~~~~~
      ! If true and MLT_option == 'TDC', include the TDC convective luminosity,
      ! convective velocity, and eddy viscosity perturbations. If false,
      ! TDC specific perturbations are suppressed even when the background model
      ! uses TDC.
      !
      ! star_LNA_include_rsp2
      ! ~~~~~~~~~~~~~~~~~~~~~
      ! If true and RSP2_flag is active, include the RSP2 variable set and
      ! luminosity decomposition. RSP2 models require this to be true.
      !
      ! star_LNA_perturb_convective_flux
      ! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
      ! If true, perturb convective luminosity where the active TDC/RSP2 branch
      ! supplies an automatic differentiation expression. If false, the convective luminosity
      ! contribution is held fixed in the active branch rows and diagnostics.
      ! This is a local "fixed Lconv" switch; by itself it does not choose the
      ! frozen flux luminosity row used by models without RSP2.
      !
      ! star_LNA_perturb_turbulent_pressure
      ! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
      ! If true, include turbulent pressure perturbations in the LNA pressure
      ! terms where supported. For RSP2 this uses Ptrb = alpha_p*(2/3)*rho*w^2.
      ! A u_flag background with active RSP2 or MLT turbulent pressure requires
      ! this option because the Riemann pressure reconstruction includes it.
      !
      ! star_LNA_perturb_eddy_viscosity
      ! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
      ! If true, include the supported eddy viscosity momentum/heating
      ! perturbations and write the eddy viscosity work diagnostic. For TDC,
      ! ``TDC_alpha_M`` controls whether the eddy viscosity term is present.
      ! RSP2 eddy viscosity is not yet supported together with ``u_flag``.
      !
      ! star_LNA_perturb_turbulent_energy
      ! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
      ! If true, include turbulent energy perturbations where supported. RSP2
      ! models require this because w and Hp are part of the RSP2 LNA
      ! variable set.
      !
      ! star_LNA_convection_treatment
      ! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
      ! Convection perturbation mode. Allowed values are 'perturbed', 'frozen',
      ! 'frozen_flux', and 'mlt_static'.
      !
      ! 'perturbed' uses the active TDC/RSP2 perturbation path. For TDC this
      ! adds the internal LNA convective velocity variable and solves the
      ! local TDC luminosity/velocity closure.
      !
      ! 'frozen' is the historical broad comparison mode. For TDC models without
      ! RSP2, it disables the TDC perturbation path, so the luminosity slot
      ! falls back to the surface temperature row at the surface and the static
      ! temperature gradient row in the interior. This is not a clean
      ! frozen convective flux approximation.
      !
      ! 'frozen_flux' is the frozen convective flux approximation for models
      ! without RSP2. It neglects the convective luminosity perturbation.
      ! Interior luminosity rows use Lrad_ad + Lconv0 - L = 0, so the
      ! equilibrium convective luminosity is retained while delta Lconv = 0.
      !
      ! No internal TDC w variable is added in frozen_flux mode. RSP2 models
      ! reject this value rather than applying only part of
      ! the approximation.
      !
      ! 'mlt_static' is for MLT backgrounds without TDC or RSP2. The interior
      ! luminosity slot uses the MESA temperature gradient relation with the
      ! background MLT derivatives. There is no dynamic convective velocity
      ! eigenfunction in this treatment.
      !
      ! ::

    star_LNA_flag = .false.
    star_LNA_model_number = -1
    star_LNA_stop_after_run = .false.
    star_LNA_T_inner = 0d0
    star_LNA_num_modes = 3
    star_LNA_min_mode_frequency_uHz = 1d-3
    star_LNA_min_first_mode_eta = -3d0
    star_LNA_min_mode_eta = -5d0
    star_LNA_max_abs_mode_eta = 10d0
    star_LNA_max_eigenvector_residual = 1d-3
    star_LNA_output_directory = ''
    star_LNA_output_file_prefix = ''
    star_LNA_write_matrix_summary = .true.
    star_LNA_write_period_growth = .true.
    star_LNA_write_eigenfunctions = .true.
    star_LNA_write_work_integrals = .true.
    star_LNA_set_initial_velocity = .false.
    star_LNA_kick_vsurf_km_per_sec = 1d0
    star_LNA_mode_for_period = 0
    star_LNA_kick_mode_1 = 1
    star_LNA_kick_mode_2 = 0
    star_LNA_kick_mode_3 = 0
    star_LNA_kick_fraction_1 = 1d0
    star_LNA_kick_fraction_2 = 0d0
    star_LNA_kick_fraction_3 = 0d0
    star_LNA_solver = 'dense'
    star_LNA_include_tdc = .true.
    star_LNA_include_rsp2 = .true.
    star_LNA_perturb_convective_flux = .true.
    star_LNA_perturb_turbulent_pressure = .true.
    star_LNA_perturb_eddy_viscosity = .true.
    star_LNA_perturb_turbulent_energy = .true.
    star_LNA_convection_treatment = 'perturbed'


! GYRE TDC LNA export controls
! ============================

      ! gyre_write_tdc_lna_background
      ! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
      ! If true, write the experimental schema 130 TDC LNA background block
      ! when exporting GYRE pulse data. This is a MESA data export
      ! only; it does not run GYRE, solve for mode perturbations, or write
      ! mode dependent complex TDC coefficients.
      !
      ! Appended schema 130 columns are real background/closure ingredients:
      ! L_conv0, A0_tdc, D_conv_h, Hp_face, alpha_MLT_face, Cp_face,
      ! chiT_face, chiRho_face, gradL_face, gradT_face, TDC_alpha_C/S/D/R/Pt/M,
      ! include_mlt_corr_to_TDC, mlt_Pturb_factor, and mlt_Pturb0_face.
      ! D_conv_h is the
      ! effective entropy diffusivity inferred from the radial TDC convective
      ! luminosity. mlt_Pturb0_face is the MESA/Kuhfuss isotropic turbulent
      ! pressure amplitude mlt_Pturb_factor*rho_face*mlt_vc^2/3.
      !
      ! Requires gyre_data_schema = 130 and MLT_option = 'TDC'. GYRE must be
      ! updated separately before it can read this experimental schema.
      ! Schema 130 does not represent the harmonic TDC mixing length. If
      ! harmonic_dissipation_length_beta > 0, MESA writes a warning and
      ! exports the legacy mixing_length_alpha and Hp_face values. GYRE will
      ! therefore use Lambda = mixing_length_alpha*Hp_face rather than the
      ! harmonic length used by MESA.
      !
      ! ::

    gyre_write_tdc_lna_background = .false.


! mass corrections
! ================


      ! use_mass_corrections
      ! ~~~~~~~~~~~~~~~~~~~~

      ! Gravitational vs baryonic mass corrections.

      ! The Lagrangian coordinate (:math:`m`) in MESA is the baryonic
      ! mass and the density (:math:`\rho`) is the baryonic mass
      ! density.

      ! If false, then no distinction between gravitational and baryonic mass.
      ! If true, then the gravitational mass is calculated using mass corrections
      ! and the momentum equation, total energy equation, and Brunt are modified.

      ! The variable ``mass_correction`` is the quantity you multiply
      ! the baryonic mass density by to get the gravitational mass
      ! density:

      !     (mass density) = (baryon density) * amu * mass_correction

      ! Given the mass fractions in a cell, the value of
      ! mass_correction is provided by the ``chem`` module.

      ! MESA holds m_grav fixed during the newton iterations.  This results
      ! in an energy conservation error, because the specific potential energy
      ! changes when m_grav is updated afterwards.  A message showing
      ! the relative energy error incurred due to this assumption
      ! will be printed to the terminal.

      ! Not compatible with RSP.

      ! ::

    use_mass_corrections = .false.


      ! phase_separation_no_diffusion
      ! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

      ! if true and element diffusion is on, prevent element diffusion
      ! from occurring in the layers where phase separation mixing
      ! is present (experimental)

      ! ::

    phase_separation_no_diffusion = .false.


! split burn
! ==========


      ! op_split_burn_min_T_for_variable_T_solver
      ! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

      ! use variable T, constant density solver for op_split_burn in cells with T >= this limit at start of step.
      ! only adopted in cells with T >= op_split_burn_min_T at start of step.

      ! ::

    op_split_burn_min_T_for_variable_T_solver = 1d99


! TDC
! ===


      ! TDC_adjust_mass_fallback_to_mlt
      ! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

      ! If TDC_adjust_mass_fallback_to_mlt = .true., cells touched by
      ! adjust_mass use MLT instead of TDC. This matches the previous behavior.
      ! If false, TDC remains enabled in those cells and uses the TDC
      ! convective velocity for the zone.

      ! ::

    TDC_adjust_mass_fallback_to_mlt = .true.


      ! TDC_use_dynamical_gradL
      ! ~~~~~~~~~~~~~~~~~~~~~~~

      ! If TDC_use_dynamical_gradL = .true., multiply the neutral gradient
      ! gradL by the ratio of the actual and QHSE pressure gradients in the
      ! TDC and RSP2 luminosity closures. This gives
      ! Y = gradT - f*gradL, where f = (dP/dm)/(dP/dm)_QHSE.
      !
      ! This option is not fully supported with the Ledoux criterion. In the
      ! uncommon get_brunt_B fallback that already uses the QHSE pressure
      ! interval, the composition term is multiplied by f a second time.

      ! ::

    TDC_use_dynamical_gradL = .false.


      ! use_TDC_enthalpy_flux_limiter
      ! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

      ! If use_TDC_enthalpy_flux_limiter = .true. , apply enthalpy flux limiter to TDC
      ! similar to the form presented in Wuchterl & Feuchtinger 1998, and Smolec 2008.
      ! RSP2 includes the limiter in its algebraic temperature-gradient closure.
      ! star_LNA linearizes the limited RSP2 relation. It ignores this limiter
      ! for TDC and linearizes the unsaturated TDC relation.

      ! ::

    use_TDC_enthalpy_flux_limiter = .false.


      ! Riemann_shock_D_mix_reduction_on
      ! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

      ! When the Riemann shock mixing reduction is enabled, leave chemical
      ! diffusion unchanged at shock strengths less than or equal to this
      ! value. The strength is the minimum of the signed compression Mach
      ! number and the HLLC pressure jump.

      ! ::

    Riemann_shock_D_mix_reduction_on = 0d0


      ! Riemann_shock_D_mix_reduction_full_on
      ! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

      ! For positive values with ``u_flag``, smoothly reduce the final chemical
      ! diffusion coefficient at compressive Riemann shock faces. The reduction
      ! changes from zero at ``Riemann_shock_D_mix_reduction_on`` to complete at
      ! this value using a quintic smootherstep. Nonpositive values disable the
      ! reduction. When positive, this value must be greater than the onset.
      ! This does not change the MLT/TDC velocity, convective luminosity, or
      ! eddy viscosity.

      ! ::

    Riemann_shock_D_mix_reduction_full_on = -1d0


      ! use_face_reconstruction
      ! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

      ! MESA interpolates primitive solver variables such as T, rho, L, and
      ! composition, together with constructed quantities such as opacity,
      ! pressure, and other EOS results, onto cell faces for use in MLT and
      ! TDC. If use_face_reconstruction = .true., this option
      ! instead reconstructs only the primitive face variables and then makes
      ! additional EOS and opacity calls to obtain the thermodynamic quantities
      ! corresponding to that face state. Despite the cost of the extra EOS and
      ! opacity work, this can improve accuracy on coarse meshes, especially in
      ! unresolved opacity bumps in pulsating envelopes, and is a potential
      ! candidate for becoming the default mode, pending further testing.

      ! ::

    use_face_reconstruction = .false.


      ! include_mlt_Pturb_in_thermodynamic_gradients
      ! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

      ! If mlt_Pturb_factor > 0, includes the effect of turbulent pressure Pturb
      ! on thermodynamic gradients gradr, grada, and hence gradT.
      ! Not supported by other_alpha_mlt or starspots

      ! ::

    include_mlt_Pturb_in_thermodynamic_gradients = .false.


      ! include_mlt_in_velocity_time_centering
      ! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

      ! If doing velocity time_centering, include time centering in mlt. Depending on the time
      ! centering flags adopted, include_mlt_in_velocity_time_centering includes time centering
      ! for P, L, and r in geff, gradr, grada, and mlt.
      ! Currently not supported together with ``use_face_reconstruction``.

      ! ::

    include_mlt_in_velocity_time_centering = .false.


! Remeshing
! =========


      ! use_hydro_merge_limits_in_mesh_plan
      ! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

      ! Allows use of ``merge_amr_max_abs_du_div_cs``, ``merge_amr_du_div_cs_limit_only_for_compression``,
      ! and ``merge_amr_inhibit_at_jumps`` in default mesh_plan when ``use_split_merge_amr = .false.``.
      ! Only supports ``v_flag``.

      ! ::

    use_hydro_merge_limits_in_mesh_plan = .false.


      ! split_merge_amr_use_metric_zoning_for_u_flag
      ! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

      ! If true, and ``use_split_merge_amr`` and ``u_flag`` are true, use the
      ! weighted split/merge metric controls below instead of the standard
      ! single-coordinate split/merge zoning controls.  This is ignored for
      ! ``v_flag``.

      ! ::

    split_merge_amr_use_metric_zoning_for_u_flag = .false.


      ! split_merge_amr_metric_logR_weight
      ! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

      ! Weight for the normalized log radius contribution in the ``u_flag``
      ! split/merge metric.

      ! ::

    split_merge_amr_metric_logR_weight = 1d0


      ! split_merge_amr_metric_logtau_weight
      ! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

      ! Weight for the normalized log optical-depth contribution in the
      ! ``u_flag`` split/merge metric.

      ! ::

    split_merge_amr_metric_logtau_weight = 1d0


      ! split_merge_amr_metric_min_delta_lnR
      ! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

      ! Floor for the log radius normalization range in the ``u_flag``
      ! split/merge metric.

      ! ::

    split_merge_amr_metric_min_delta_lnR = 1d-9


      ! split_merge_amr_metric_min_delta_lntau
      ! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

      ! Floor for the log optical-depth normalization range in the ``u_flag``
      ! split/merge metric.

      ! ::

    split_merge_amr_metric_min_delta_lntau = 1d-9


      ! split_merge_amr_reconstruct_pressure_for_u_flag
      ! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

      ! If true, redistribute internal energy between the children of an
      ! ``u_flag`` split to preserve the limited pre-split pressure gradient.
      ! The correction preserves total child internal energy and falls back to
      ! the standard conservative split when no bounded EOS solution exists.
      ! The pressure target includes MLT turbulent pressure. Split/merge AMR
      ! does not currently support RSP2.

      ! ::

    split_merge_amr_reconstruct_pressure_for_u_flag = .false.
