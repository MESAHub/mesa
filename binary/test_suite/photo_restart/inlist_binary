&binary_job

evolve_both_stars = .true.

/

&binary_controls

m1 = 1.0d0  ! donor mass in Msun
m2 = 0.8d0 ! companion mass in Msun
initial_period_in_days = 0.5d0

fr = 0.01
fr_limit = 1d-3

limit_retention_by_mdot_edd = .false.

photo_interval = 1
/

&pgbinary
read_extra_pgbinary_inlist(1) = .true.
extra_pgbinary_inlist_name(1)= 'inlist_pgbinary'

/
